{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist/main",
    "noEmit": false
  },
  "include": ["src/main", "src/lib"],
  "exclude": ["src/lib/*.test.ts", "src/renderer"]
}
