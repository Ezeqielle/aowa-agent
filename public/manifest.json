{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "AOWA Agent",
    "version": "0.1.0",
    "minimum-overwolf-version": "0.239.0",
    "author": "Ashguard",
    "icon": "icons/icon256.png",
    "icon_gray": "icons/icon256_gray.png",
    "launcher_icon": "icons/icon.ico",
    "description": "Syncs your live Warframe inventory to your AOWA account."
  },
  "permissions": ["GameInfo", "Extensions"],
  "data": {
    "start_window": "background",
    "windows": {
      "background": {
        "file": "src/background/background.html",
        "is_background_page": true,
        "debug_url": "http://localhost:5173/src/background/background.html"
      },
      "settings": {
        "file": "src/settings/settings.html",
        "desc_maximized": false,
        "transparent": false,
        "resizable": false,
        "show_in_taskbar": true,
        "native_window": true,
        "size": { "width": 440, "height": 560 },
        "min_size": { "width": 440, "height": 560 },
        "debug_url": "http://localhost:5173/src/settings/settings.html"
      }
    },
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [8954]
    },
    "game_events": [8954],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": { "game_ids": [8954] },
        "start_minimized": true
      }
    ],
    "url_protocol": { "scheme": "aowa" },
    "protocol_override_domains": {}
  }
}
