# Copy to .env and fill in. .env is gitignored.
#
# Overwolf dev-mode key — request a temporary OW_DEV_KEY from the Overwolf
# developer portal (approved devs without Console access). It lets the gaming
# packages (GEP, Overlay, Recorder) load in an unsigned local build.
# Requires @overwolf/ow-electron >= 39.8.10 and is Windows-only.
#
# Alternatively, Console developers can use OW_CLI_EMAIL + OW_CLI_API_KEY
# (API key from Overwolf Console > Profile > API Keys) instead of OW_DEV_KEY.
OW_DEV_KEY=

# OW_CLI_EMAIL=
# OW_CLI_API_KEY=
